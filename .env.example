ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=your-gemini-key-here
# Optional: multiple keys for automatic daily-quota fallback (each free-tier
# Google Cloud project has its own 20/day cap). If set, this takes priority
# over the single GEMINI_API_KEY above.
# GEMINI_API_KEYS=key-one,key-two,key-three
# Which backend agent.py uses when --backend isn't passed: "claude" or "gemini"
VLA_BACKEND=gemini
